# Server-side only. Do not expose these in browser code.
GEMINI_API_KEY=
# Image-capable Gemini models. Do not use gemini-3.5-flash for image generation.
# Try gemini-3-pro-image-preview if your Google AI project has access and billing/quota.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VISION_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-5.2
OPENAI_VISION_MODEL=gpt-5-mini
